# ==============================================================================
# CONFIGURAÇÕES DO n8n E BANCO DE DADOS (POSTGRESQL)
# ==============================================================================

# IP da VPS onde o n8n estará acessível
N8N_HOST=IP_DA_SUA_VPS

# Protocolo (http para acesso direto via IP, https para domínio com SSL)
N8N_PROTOCOL=http

# URL completa do Webhook (obrigatório para integração correta de webhooks externos)
WEBHOOK_URL=http://IP_DA_SUA_VPS:5678/

# Fuso horário padrão do n8n
GENERIC_TIMEZONE=America/Sao_Paulo

# Chave de criptografia interna (usada para criptografar as credenciais salvas no banco)
# IMPORTANTE: Altere para uma chave aleatória e segura. Não perca essa chave!
N8N_ENCRYPTION_KEY=defina_uma_chave_aleatoria_super_segura_aqui

# Porta interna do n8n (padrão)
N8N_PORT=5678

# Configuração de cookies seguros (deve ser false ao rodar em HTTP direto por IP)
N8N_SECURE_COOKIE=false

# ==============================================================================
# CONFIGURAÇÕES DO POSTGRESQL
# ==============================================================================
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=defina_uma_senha_segura_para_o_banco_aqui
POSTGRES_DB=n8n_database
POSTGRES_HOST=db
POSTGRES_PORT=5432
