# ==============================================================================
# CONFIGURAÇÕES DO n8n E BANCO DE DADOS (POSTGRESQL)
# ==============================================================================

# Domínio onde o n8n estará acessível (ex: n8n.seudominio.com)
# IMPORTANTE: Altere para o seu subdomínio real apontado para a VPS
N8N_HOST=n8n.seudominio.com

# URL completa do Webhook (obrigatório para integração correta de webhooks externos)
# IMPORTANTE: Altere de acordo com o seu domínio real
WEBHOOK_URL=https://n8n.seudominio.com/

# Fuso horário padrão do n8n (pode ajustar para sua região)
GENERIC_TIMEZONE=America/Sao_Paulo

# Chave de criptografia interna (gerada automaticamente com valor seguro)
N8N_ENCRYPTION_KEY=9a7c3f81e64b2d5f0a9c8d7e6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a

# Porta interna do n8n
N8N_PORT=5678

# Configuração de cookies seguros (true por usar HTTPS via Caddy)
N8N_SECURE_COOKIE=true

# ==============================================================================
# CONFIGURAÇÕES DO POSTGRESQL (GERADAS COM VALORES SEGUROS)
# ==============================================================================
POSTGRES_USER=n8n_postgres_admin
POSTGRES_PASSWORD=n8n_db_secure_pass_4e8f9d0a1b
POSTGRES_DB=n8n_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==============================================================================
# CONFIGURAÇÕES DO PROXY REVERSO (CADDY / SSL)
# ==============================================================================
# E-mail utilizado para registrar e receber notificações do certificado Let's Encrypt
SSL_EMAIL=seu-email@seudominio.com
