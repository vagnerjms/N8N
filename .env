# ==============================================================================
# CONFIGURAÇÕES DO n8n E BANCO DE DADOS (POSTGRESQL)
# ==============================================================================

# IP da VPS onde o n8n estará acessível
N8N_HOST=179.197.231.106

# Protocolo (http para acesso direto via IP, https para domínio com SSL)
N8N_PROTOCOL=http

# URL completa do Webhook (obrigatório para integração correta de webhooks externos)
WEBHOOK_URL=http://179.197.231.106:5678/

# Fuso horário padrão do n8n (pode ajustar para sua região)
GENERIC_TIMEZONE=America/Sao_Paulo

# Chave de criptografia interna (gerada automaticamente com valor seguro)
N8N_ENCRYPTION_KEY=9a7c3f81e64b2d5f0a9c8d7e6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a

# Porta interna do n8n
N8N_PORT=5678

# Configuração de cookies seguros (false por usar HTTP direto via IP)
N8N_SECURE_COOKIE=false

# ==============================================================================
# CONFIGURAÇÕES DO POSTGRESQL (GERADAS COM VALORES SEGUROS)
# ==============================================================================
POSTGRES_USER=n8n_postgres_admin
POSTGRES_PASSWORD=n8n_db_secure_pass_4e8f9d0a1b
POSTGRES_DB=n8n_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
