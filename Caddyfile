{$N8N_HOST} {
    # Redireciona todas as requisições para o contêiner do n8n na porta correspondente
    reverse_proxy n8n:5678 {
        # Caddy gerencia conexões WebSocket automaticamente, necessário para as atualizações em tempo real do n8n
        flush_interval -1
    }

    # Habilita compressão Gzip/zstd para melhorar performance
    encode gzip zstd

    # Configuração global de e-mail para Let's Encrypt (opcional, mas recomendado)
    log {
        output file /var/log/caddy/access.log
    }
}
